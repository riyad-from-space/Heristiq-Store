# ---------------------------------------------------------------- ERP database
# The SAME Supabase project as heristiq-erp. The storefront reads the ERP's
# catalogue, price and stock from it and writes its own orders alongside.
#
# Supabase → Project Settings → API. NOTE: the service_role key, not the anon
# key. The ERP's RLS grants access to `authenticated` only and its migration
# 0011 revoked `anon` from every function, so an anon key reads nothing.
#
# This key bypasses RLS. It is read only by server code (lib/env.ts is
# `server-only`) and must never be given a NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Leave both blank to browse the site against the seeded mock catalogue.
# Set this to 1 to force the mock even when the keys above are present.
ERP_USE_MOCK=

# ------------------------------------------------------------------ Cloudinary
# All product photography. Without a cloud name the site renders designed
# placeholder tiles instead of broken images, so this is optional in dev.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_FOLDER=heristiq

# -------------------------------------------------------------------- Commerce
# Fallbacks only. From phase 6 the live values come from the storefront_settings
# table so the owner can change them from a phone without a deploy.
DELIVERY_FEE_INSIDE_DHAKA=70
DELIVERY_FEE_OUTSIDE_DHAKA=130
FREE_DELIVERY_THRESHOLD=1500
LOW_STOCK_THRESHOLD=3

# ----------------------------------------------------------------- Signing key
# Signs the phone-verification cookie and hashes OTP codes before they are
# stored. REQUIRED IN PRODUCTION and a hard failure without it: an unsigned
# cookie is one anyone can forge into "this number is verified", which is the
# entire control it exists to provide.
#
#   openssl rand -hex 32
#
# Left blank in development, a fixed development-only value is used instead, so
# a fresh clone can run the whole checkout.
STOREFRONT_SECRET=

# ---------------------------------------------------------------- SMS gateway
# Delivers the OTP. Leave SMS_API_URL blank and codes are written to the server
# log instead (and shown on the checkout screen) — which is how you test the
# flow with no SMS account.
#
# The URL is a template: {key} {sender} {phone} {message} are substituted and
# URL-encoded. Any Bangladeshi bulk-SMS provider fits; this is BulkSMSBD's shape:
#
#   SMS_API_URL=https://bulksmsbd.net/api/smsapi?api_key={key}&type=text&number={phone}&senderid={sender}&message={message}
#
# Set SMS_API_METHOD=POST for the providers that require a JSON body instead.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_API_METHOD=GET

# ------------------------------------------------------------------------ OTP
# Defaults are sensible; these exist so limits can be tightened without a
# code change if the site starts being used to send someone else nuisance SMS.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Return the code to the browser instead of texting it. On by default outside
# production and IGNORED in production, unconditionally.
OTP_DEBUG=

# --------------------------------------------------------------------- Courier
# Pathao is the courier this business uses and is implemented fully. Steadfast
# is implemented too; RedX is a stub. Leave these blank and, outside
# production, a demo courier stands in so the push, the webhook, the tracking
# page and the status rail can all be walked with nothing configured.
#
# SET UP AND VERIFY IN ONE COMMAND:  node scripts/courier-check.mjs
# It issues a token, lists your stores (this is the only way to discover
# PATHAO_STORE_ID), and resolves a sample address through the same matcher the
# push uses — which is the step most likely to be wrong.

# Credentials: Pathao merchant panel → Developers API → Merchant API Credentials.
# The username/password are your merchant login, not the client id/secret.
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=

# One of the store ids that scripts/courier-check.mjs prints. Required.
PATHAO_STORE_ID=

# `sandbox` points at courier-api-sandbox.pathao.com for testing with the
# sandbox credentials Pathao issues separately. Anything else is production.
PATHAO_ENVIRONMENT=production

# Who the parcel is from. Pathao requires both on every order; this is the name
# and number the recipient sees and the number their pickup rider calls.
PATHAO_SENDER_NAME=Heristiq
PATHAO_SENDER_PHONE=

# Declared weight in kg. Pathao prices on it and their minimum is 0.5.
PATHAO_ITEM_WEIGHT=0.5

# The secret Pathao sends back in the X-PATHAO-Signature header on every
# webhook. Set the same value in their merchant dashboard and point the
# callback URL at https://heristiq.com/api/webhooks/pathao
# WITHOUT this the webhook route rejects everything — the right default for an
# endpoint that can mark an order delivered, and so mark cash as collected that
# nobody collected.
PATHAO_WEBHOOK_SECRET=

# Only if Pathao moves the host. Normally derived from PATHAO_ENVIRONMENT.
PATHAO_BASE_URL=

# --- Steadfast (also implemented; set COURIER_DEFAULT=steadfast to use it)
# Steadfast serves the same API from portal.steadfast.com.bd and
# portal.packzy.com. If auth fails on one, try the other.
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# Their webhook sends `Authorization: Bearer <this>`; callback URL is
# https://heristiq.com/api/webhooks/steadfast
STEADFAST_WEBHOOK_TOKEN=
# The one Steadfast endpoint whose path is not confirmed against current docs.
# {phone} is substituted. Advisory — a wrong path logs and blocks nothing.
STEADFAST_FRAUD_CHECK_PATH=fraud_check/{phone}

# --- RedX (stub). One long-lived access token.
REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta
REDX_ACCESS_TOKEN=

# Who carries a parcel when the customer expressed no preference.
COURIER_DEFAULT=pathao
# 0 = deliver to the door (Pathao "normal", 48). 1 = on-demand (Pathao 12).
COURIER_DELIVERY_TYPE=0
# Flag an order for a phone call when the recipient's courier history is worse
# than this, once they have at least this many parcels of history. Advisory:
# it annotates an order, it never refuses one.
COURIER_RISK_SUCCESS_FLOOR=60
COURIER_RISK_MIN_PARCELS=3

# ----------------------------------------------------------------------- Admin
# Bearer token for the endpoints that change an order — currently the one-tap
# courier push. NO fallback in any environment: with this unset the endpoint is
# closed, because everything it does is irreversible and hands a customer's
# address to a third party.
#
#   openssl rand -hex 24
#   node scripts/ship.mjs HQ-01042
ADMIN_TOKEN=

# Where scripts/ship.mjs should point. Defaults to localhost.
STORE_URL=http://localhost:3000

# ------------------------------------------------------------------------ Site
NEXT_PUBLIC_SITE_URL=https://heristiq.com
