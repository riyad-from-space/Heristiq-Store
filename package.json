{
  "name": "heristiq",
  "private": true,
  "description": "Heristiq — the storefront and the ERP, one database, one repo.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/store",
    "dev:erp": "npm run dev --workspace apps/erp",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "deploy:store": "npm run deploy --workspace apps/store",
    "deploy:erp": "npm run deploy --workspace apps/erp"
  }
}
