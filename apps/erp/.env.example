# Get these from Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The ERP is served under this path so it can share heristiq.com with the
# storefront. Baked into the client bundle at build time, so changing it needs a
# rebuild. Set it EMPTY to serve the ERP at the root of its own hostname.
ERP_BASE_PATH=/admin

# ------------------------------------------------------------------- ERP admin
# Comma-separated addresses allowed into the ERP, in addition to whoever is in
# the erp_admins table. The table is the one the DATABASE enforces; this is a
# second lever you can change without touching data.
#
# Leave blank AND leave erp_admins empty and the ERP stays open to any
# signed-in account — the ERP shows a loud banner and a one-click fix for that.
ERP_ADMIN_EMAILS=

# ------------------------------------------------------- Courier push bridge
# So the ERP's "Send to courier" button can call the storefront's push
# endpoint instead of reimplementing the whole courier layer. ADMIN_TOKEN must
# match the storefront's.
STOREFRONT_URL=http://localhost:3000
ADMIN_TOKEN=

# -------------------------------------------------------------- Photographs
# Product photographs are uploaded from the product page straight to
# Cloudinary — the file never passes through this server, which signs a ticket
# and nothing more. Same account as the storefront.
#
# CLOUDINARY_API_SECRET is server-only. It is never sent to the browser; see
# src/lib/cloudinary.ts, which is `server-only` so a stray import is a build
# error rather than a leak.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional. Defaults to "heristiq" — set it to point at a staging folder.
CLOUDINARY_FOLDER=
