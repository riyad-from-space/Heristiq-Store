# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — per app, since each app builds into its own directory
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...and the templates are the opt-in. They hold no secrets, and the READMEs
# tell a fresh clone to copy them — which only works if they are in the repo.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloudflare
.dev.vars
.open-next/
.wrangler/
cloudflare-env.d.ts

# Layout audit output (apps/store/scripts/shoot.mjs)
.shots/

# Resized image variants, rebuilt from the originals before every build by
# apps/store/scripts/image-manifest.mjs. The ORIGINALS in public/products/ are
# committed — they are the source of truth for the site's photography.
apps/store/public/products/_r/

# Camera masters staged for upload (npm run images:upload, from apps/store).
#
# Deliberately NOT committed. These are full-resolution phone originals — 33MB
# for ten photographs, and a shop that reshoots will add more. Git keeps every
# version of a binary forever and cannot be made to forget one without
# rewriting history, so committing them taxes every future clone permanently
# for files the site never serves: Cloudinary holds the master it delivers
# from, and public/products/ holds the committed fallback copies.
#
# THIS IS NOT A BACKUP. Ignoring them means the only copies are this Mac and
# Cloudinary. Keep the originals somewhere that survives a lost laptop.
cloudinary_images/

# Supabase CLI scratch state (project ref, temp files) — machine-local.
supabase/.temp/
