# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — per app, since each app builds into its own directory
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...and the templates are the opt-in. They hold no secrets, and the READMEs
# tell a fresh clone to copy them — which only works if they are in the repo.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloudflare
.dev.vars
.open-next/
.wrangler/
cloudflare-env.d.ts

# Layout audit output (apps/store/scripts/shoot.mjs)
.shots/
